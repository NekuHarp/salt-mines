# Value in {development, staging, production}
NODE_ENV=
PORT=

DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=

# API credentials
SALT_MINES_USER_NAME=
SALT_MINES_USER_PASSWORD=

# Comma-separated list of browser origins allowed to call the API. Each entry is
# scheme + host + port, with no path — that is all a browser ever sends in the
# Origin header. A trailing slash is stripped for you.
# Unset or blank defaults to http://localhost:5173, the salt-mines-headquarters
# dev server. Set it to `none` to disable CORS entirely.
CORS_ALLOWED_ORIGINS=

# Salty Bet account credentials, used to authenticate and place bets
SALTY_BET_USER_EMAIL=
SALTY_BET_USER_PWORD=